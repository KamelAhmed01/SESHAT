{
  "name": "seshat",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-traceable Mars science opportunity workbench",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start:export": "python3 -c \"import functools,http.server;s=type('S',(http.server.ThreadingHTTPServer,),{'request_queue_size':128,'allow_reuse_address':True});s(('127.0.0.1',4173),functools.partial(http.server.SimpleHTTPRequestHandler,directory='out')).serve_forever()\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run check:engine:offline",
    "verify": "python3 -m tools.verify --release",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "check:engine:offline": "tsc -p tsconfig.engine.json && node --test tests/unit/*.test.cjs",
    "check:pipeline": "python3 -m pytest -q pipeline/tests",
    "verify:offline": "python3 -m tools.verify --offline",
    "test:e2e": "playwright test",
    "test:security": "python3 -m pytest -q tests/security"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.14",
    "@astryxdesign/theme-neutral": "0.7.14",
    "@stylexjs/stylex": "0.19.1",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.14",
    "@tailwindcss/postcss": "4.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5.8.3",
    "@playwright/test": "^1.57.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.20.0"
}
