  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "strict": true, "skipLibCheck": true, "rootDir": ".", "outDir": ".build",
    "noEmit": false, "esModuleInterop": true, "resolveJsonModule": true
